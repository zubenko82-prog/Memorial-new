{
  "name": "@memorial/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../../scripts/generate-catalog.mjs",
    "dev": "vite --port 5173 --strictPort",
    "dev:server": "nodemon server/index.js",
    "dev:full": "concurrently \"npm:dev\" \"npm:dev:server\"",
    "generate:catalogs": "node ../../scripts/generate-catalog.mjs",
    "generate:carvings": "node ../../scripts/generate-catalog.mjs carvings",
    "generate:graphics": "node ../../scripts/generate-catalog.mjs graphics",
    "prebuild": "npm run generate:catalogs",
    "build": "vite build",
    "preview": "vite preview --port 5173 --strictPort"
  },
  "dependencies": {
    "express": "^4.19.2",
    "html2canvas": "1.4.1",
    "lg-thumbnail": "^1.2.1",
    "lg-zoom": "^1.3.0",
    "lightgallery": "^2.9.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
